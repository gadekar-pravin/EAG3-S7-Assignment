# Required: at least one LLM provider key for the gateway (../llm_gatewayV7)
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: additional gateway providers (enables failover)
OPEN_ROUTER_API_KEY=your-openrouter-key

# Optional: embedding model override (default: gemini-embedding-001)
EMBED_FALLBACK_MODEL=gemini-embedding-001

# Optional: premium web search (falls back to DuckDuckGo without it)
TAVILY_API_KEY=tvly-dev-...
